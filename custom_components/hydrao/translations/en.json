    "select": {
      "threshold_color": {
        "name": "LED threshold {number} color",
        "state": {
          "yellow": "Yellow",
          "orange": "Orange",
          "red": "Red",
          "purple": "Purple",
          "blue": "Blue",
          "light_blue": "Light blue",
          "green": "Green",
          "light_green": "Light green",
          "off": "Off"
        }
      }
